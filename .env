# ── SFA mTLS POC (docker-compose.yml) ─────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_local_dev

# Keycloak Admin (bootstrap inicial)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin_local_dev

# Hostname público vía gateway mTLS (Nginx :8443)
KC_HOSTNAME=https://sfa.localtest.me:8443

# Issuer esperado por Resource Server (debe coincidir con claim iss del JWT)
KEYCLOAK_ISSUER=https://sfa.localtest.me:8443/realms/sfa-mtls-poc

# Hostnames del gateway (añadir a /etc/hosts → 127.0.0.1)
#   sfa.localtest.me   → Keycloak mTLS :8443
#   api.localtest.me   → Resource Server mTLS :9443
