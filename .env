# ── SFA POC (docker-compose.yml) ──────────────────────────────────────────────

# PostgreSQL — sfa-poc
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_local_dev

# Keycloak Admin — sfa-poc (solo bootstrap inicial)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin_local_dev

# Hostname — sfa-poc (localtest.me evita contexto seguro de localhost; necesario para broker HTTP con IdP remoto)
KC_HOSTNAME=http://sfa.localtest.me:8080

# ── BCI IDP (docker-compose.bci-idp.yml) ──────────────────────────────────────

# PostgreSQL — bci-idp
BCI_POSTGRES_DB=keycloak_bci
BCI_POSTGRES_USER=keycloak_bci
BCI_POSTGRES_PASSWORD=bci_keycloak_local_dev

# Keycloak Admin — bci-idp (solo bootstrap inicial)
BCI_KC_BOOTSTRAP_ADMIN_USERNAME=admin
BCI_KC_BOOTSTRAP_ADMIN_PASSWORD=bci_admin_local_dev

# Hostname — bci-idp
BCI_KC_HOSTNAME=http://10.67.245.106:5050
