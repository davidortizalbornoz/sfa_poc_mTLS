PORT=9090
KEYCLOAK_ISSUER=https://sfa.localtest.me:8443/realms/sfa-mtls-poc
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/sfa-mtls-poc/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=resource-server
REQUIRED_SCOPE=accounts:read
# true en despliegue vía gateway (default). false solo para pruebas directas a :9090 sin nginx.
MTLS_CLIENT_CERT_REQUIRED=true
