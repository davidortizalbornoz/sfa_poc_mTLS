# Claims del Software Statement (SSA) — valores por defecto del POC
# Copia a ssa.env para personalizar (desde clientRegistrationPolicy/): cp ssa.env.example ssa.env
# Ruta alternativa: SSA_ENV=/ruta/custom.env ./scripts/generate-test-ssa.sh
#
# Documentación de scripts y artefactos generados: README.md
#   - generate-root-ca.sh        → registro_participantes/ca/
#   - generate-client-jwks.sh    → client-jwks/{SSA_SOFTWARE_ID}/
#   - generate-test-ssa.sh       → registro_participantes/sample-software-statement.jwt

# Emisor del SSA (Directorio de participantes)
SSA_ISSUER=https://directorio-qa.finanzasabiertas.cl

# Participante / software registrado
SSA_SOFTWARE_ID=LIDER-BCI
SSA_ORGANISATION_ID="LIDER-BCI"
SSA_SOFTWARE_JWKS_URI=https://fintech-lider-bci.localtest.me/.well-known/jwks.json
SSA_SOFTWARE_CLIENT_NAME="SFA mTLS POC - DCR + SSA"
SSA_SOFTWARE_VERSION=1.2.9

# URIs de redirección (separadas por coma)
SSA_REDIRECT_URIS=http://localhost:3000/callback

# kid del JWT de firma del Directorio (debe coincidir con registro_participantes/directory-jwks.json)
SSA_JWT_KID=sfa-poc-directory-1

# CA raíz del POC (registro_participantes/ca/) — script: generate-root-ca.sh
# Salida: root-ca.crt (truststore AS/Gateway), root-ca.key (emite transport.crt), root-ca.srl
CA_SUBJECT="/CN=SFA POC Root CA/O=Finanzas Abiertas POC/C=CL"
CA_VALIDITY_DAYS=3650
CA_KEY_BITS=4096

# Certificado mTLS de transporte del TPP — script: generate-client-jwks.sh
# Salida en client-jwks/{SSA_SOFTWARE_ID}/: transport.key, transport.crt, transport-chain.crt
# SSA_MTLS_CN            → Common Name del certificado (default: SSA_SOFTWARE_ID)
# SSA_MTLS_ORGANIZATION  → Organization O= (default: SSA_ORGANISATION_ID)
# SSA_MTLS_SAN_DNS       → Subject Alternative Name DNS (default: host de SSA_SOFTWARE_JWKS_URI)
SSA_MTLS_VALIDITY_DAYS=825
SSA_MTLS_KEY_BITS=2048
